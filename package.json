{
  "name": "rdpilot",
  "version": "1.0.0",
  "description": "RDPilot - Windows 远程桌面连接管理器",
  "main": "out/main/index.js",
  "author": "RDPilot contributors",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/1728578755/rdpilot.git"
  },
  "homepage": "https://github.com/1728578755/rdpilot#readme",
  "bugs": {
    "url": "https://github.com/1728578755/rdpilot/issues"
  },
  "keywords": [
    "rdp",
    "remote-desktop",
    "electron",
    "windows",
    "connection-manager",
    "freerdp"
  ],
  "engines": {
    "node": ">=20"
  },
  "os": [
    "win32"
  ],
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "build:rdphost": "node scripts/build-rdp-host.mjs",
    "build:certprobe": "node scripts/build-cert-probe.mjs",
    "build:native": "npm run build:rdphost && npm run build:certprobe",
    "patch:freerdp": "node scripts/patch-freerdp-dpi.mjs",
    "check:freerdp-dpi": "node scripts/patch-freerdp-dpi.mjs --check",
    "preview": "electron-vite preview",
    "build:win": "npm run build:native && npm run patch:freerdp && electron-vite build && electron-builder --win --config electron-builder.yml --publish never && npm run release:checksums",
    "release:checksums": "node scripts/release-checksums.mjs",
    "release:sbom": "node -e \"require('fs').mkdirSync('release',{recursive:true})\" && npm sbom --sbom-format=cyclonedx > release/sbom.cdx.json",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "audit": "npm audit --omit=dev --audit-level=high",
    "verify:conn": "node scripts/verify-connect.mjs",
    "verify:b4-session": "node scripts/verify-b4-session.mjs",
    "verify:capabilities": "node scripts/verify-capabilities.mjs",
    "verify:tray": "node scripts/verify-tray.mjs",
    "verify:chrome": "node scripts/verify-chrome.mjs",
    "verify:i18n": "node scripts/verify-i18n.mjs",
    "verify:data": "node scripts/verify-data.mjs",
    "verify:restore-credentials": "node scripts/verify-restore-credentials.mjs",
    "verify:import": "node scripts/verify-import.mjs",
    "verify:hostname": "node scripts/verify-hostname.mjs",
    "verify:csv": "node scripts/verify-csv.mjs",
    "verify:ui": "node scripts/verify-ui.mjs",
    "audit:ui": "node scripts/audit-ui-align.mjs",
    "ui:text": "node scripts/ui-to-text.mjs",
    "verify:layout": "node scripts/verify-layout.mjs",
    "verify:import-formats": "node scripts/verify-import-formats.mjs",
    "verify:import-export": "node scripts/verify-import-export.mjs",
    "verify:export-secrets": "node scripts/verify-export-secrets.mjs",
    "verify:credentials": "node scripts/verify-credentials.mjs",
    "verify:organization": "node scripts/verify-organization.mjs",
    "verify:monitor": "node scripts/verify-monitor.mjs",
    "verify:probe-rdp": "node scripts/verify-probe-rdp.mjs",
    "verify:settings": "node scripts/verify-settings.mjs",
    "verify:grid": "node scripts/verify-settings-grid.mjs --width 1440 --height 950",
    "verify:integrity": "node scripts/verify-integrity.mjs",
    "verify:palette": "node scripts/verify-palette.mjs",
    "verify:host": "node scripts/verify-host.mjs",
    "verify:a11y": "node scripts/verify-a11y.mjs",
    "verify:status": "node scripts/verify-status-color.mjs",
    "verify:visual": "node scripts/verify-visual-tokens.mjs",
    "verify:deeplink": "node scripts/verify-deeplink.mjs",
    "verify:cli": "node scripts/verify-cli.mjs",
    "verify:docs": "node scripts/verify-docs.mjs",
    "verify:log-redaction": "node scripts/verify-log-redaction.mjs",
    "verify:migrations": "node scripts/verify-migrations.mjs",
    "verify:cmdkey": "node scripts/verify-cmdkey.mjs",
    "verify:batch": "node scripts/verify-batch-connect.mjs",
    "verify:batch-window": "node scripts/verify-batch-window.mjs",
    "verify:host-ui": "node scripts/verify-host-ui.mjs",
    "verify:freerdp-quality": "node scripts/verify-freerdp-quality.mjs",
    "verify:session-size": "node scripts/verify-session-size.mjs",
    "verify:live": "node scripts/verify-live-connect.mjs",
    "fake:rdp": "node scripts/fake-rdp-server.mjs",
    "verify": "npm run typecheck && npm run verify:session-size && npm run verify:wall-service && npm run verify:wall-layout && npm run verify:parallel && npm run verify:batch && npm run verify:conn && npm run verify:b4-session && npm run verify:capabilities && npm run verify:tray && npm run verify:i18n && npm run verify:data && npm run verify:restore-credentials && npm run verify:import && npm run verify:import-formats && npm run verify:import-export && npm run verify:export-secrets && npm run verify:credentials && npm run verify:organization && npm run verify:monitor && npm run verify:probe-rdp && npm run verify:settings && npm run verify:integrity && npm run verify:palette && npm run verify:host && npm run verify:a11y && npm run verify:hostname && npm run verify:status && npm run verify:visual && npm run verify:chrome && npm run verify:deeplink && npm run verify:cli && npm run verify:docs && npm run verify:log-redaction && npm run verify:migrations && node scripts/smoke.mjs",
    "verify:wall": "node scripts/verify-wall.mjs",
    "verify:wall-dispose": "node scripts/verify-wall-dispose.mjs",
    "verify:wall-service": "node scripts/verify-wall-service.mjs",
    "verify:wall-layout": "node scripts/verify-wall-layout.mjs",
    "verify:parallel": "node scripts/verify-parallel.mjs"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "autoprefixer": "^10.4.20",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "electron-vite": "^2.3.0",
    "esbuild": "^0.21.5",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.15",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  }
}
